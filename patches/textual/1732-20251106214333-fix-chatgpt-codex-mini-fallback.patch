+fn maybe_override_chatgpt_model(
+    model: &mut String,
+    auth: Option<CodexAuth>,
+) -> Option<DeprecationNoticeEvent> {
+    let auth = auth?;
+    if auth.mode != AuthMode::ChatGPT {
+        return None;
+    }
+    if model != GPT5_CODEX_MINI_MODEL {
+        return None;
+    }
+
+    *model = GPT_5_CODEX_MEDIUM_MODEL.to_string();
+    let summary = format!(
+        "ChatGPT logins cannot use {GPT5_CODEX_MINI_MODEL}; using {GPT_5_CODEX_MEDIUM_MODEL} instead."
+    );
+    let details = Some(
+        "Use an API key with codex-mini access (or a workspace plan that explicitly enables it) \
+         if you need the smaller model."
+            .to_string(),
+    );
+    Some(DeprecationNoticeEvent { summary, details })
+}
 
