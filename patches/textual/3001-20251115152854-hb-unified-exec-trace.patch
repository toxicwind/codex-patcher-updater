+fn trace_file_path() -> Option<&'static PathBuf> {
+    TRACE_FILE_PATH
+        .get_or_init(|| match env::var_os("HB_CODEX_TRACE_DIR") {
+            Some(path) if !path.is_empty() => {
+                let dir = PathBuf::from(path);
+                if let Err(err) = std::fs::create_dir_all(&dir) {
+                    warn!(?err, path = %dir.display(), "failed to create HB_CODEX_TRACE_DIR");
+                    return None;
+                }
+                Some(dir.join("unified-exec.log"))
+            }
+            _ => None,
+        })
+        .as_ref()
+}
+
+fn log_unified_exec_chunk(kind: &str, response: &UnifiedExecResponse) {
+    let Some(path) = trace_file_path() else {
+        return;
+    };
+
+    let timestamp = SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .unwrap_or_default()
+        .as_secs_f64();
+
+    let payload = json!({
+        "ts": timestamp,
+        "kind": kind,
+        "call_id": response.event_call_id,
+        "chunk_id": response.chunk_id,
+        "session_id": response.session_id,
+        "exit_code": response.exit_code,
+        "tokens": response.original_token_count,
+        "pending": response.session_id.is_some() && response.exit_code.is_none(),
+        "output": response.output,
+    });
+
+    if let Err(err) = append_json_line(path, payload.to_string()) {
+        warn!(?err, path = %path.display(), "failed to append unified exec trace entry");
+    }
+}
+
+fn append_json_line(path: &Path, line: String) -> std::io::Result<()> {
+    let mut file = OpenOptions::new().create(true).append(true).open(path)?;
+    file.write_all(line.as_bytes())?;
+    file.write_all(b"\n")
+}
+
